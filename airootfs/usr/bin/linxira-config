#!/bin/bash
# Linxira Config Hub - CLI Tool v2.2
# Cross-ecosource configuration & security manager

set -euo pipefail

VERSION="2.5.1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CATALOG_PATH="${LINXIRA_CATALOG_PATH:-/usr/share/linxira/catalog/catalog-v3.json}"
CATALOG_STATE_PATH="${LINXIRA_CATALOG_STATE_PATH:-/var/lib/linxira/catalog/state-v1.json}"

# Colors
# ANSI-C quoted so the variables hold real ESC characters; plain cat (help
# heredoc) and printf output then render colors correctly without echo -e.
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

info() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
header() { echo -e "\n${BOLD}${CYAN}=== $1 ===${NC}"; }

backend_pending() {
    error "This action is disabled until the Linxira system transaction backend provides plan, verify, receipt, and rollback support."
}

require_root() {
    local uid
    uid=$(id -u 2>/dev/null) || error "This command requires root privileges. Use sudo."
    [[ $uid =~ ^[0-9]+$ ]] || error "This command requires root privileges. Use sudo."
    [ "$uid" -eq 0 ] || error "This command requires root privileges. Use sudo."
}

validate_port() {
    local port=$1
    [[ $port =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || \
        error "Invalid port: $port (use a number from 1 to 65535)"
}

validate_dns_server() {
    local server=$1
    [[ $server =~ ^[0-9A-Fa-f:.]+$ ]] || error "Invalid DNS server address: $server"
    [[ $server != *[[:space:]/]* ]] || error "Invalid DNS server address: $server"
}

target_user() {
    local uid=${PKEXEC_UID:-}
    if [[ $uid =~ ^[0-9]+$ ]] && ((uid > 0)); then
        getent passwd "$uid" | cut -d: -f1
    elif [[ -n ${SUDO_USER:-} && ${SUDO_USER} != root ]]; then
        printf '%s\n' "$SUDO_USER"
    elif [[ ${USER:-} != root ]]; then
        printf '%s\n' "$USER"
    else
        logname 2>/dev/null || true
    fi
}

# ─── Help ────────────────────────────────────────────────────

show_help() {
    cat << EOF
${BOLD}Linxira Config Hub v${VERSION}${NC}

${BOLD}Usage:${NC} linxira-config <command> [action] [options]

${BOLD}Commands:${NC}
  mirror <action>       Package mirror management
  logs <action>         Diagnostic log collect & upload (collect/upload)
  source                Show package sources
  service <svc> <act>   Disabled pending transactional backend
  security <action>     Security hardening & firewall
  ssh <action>          SSH server & key management
  rdp <action>          Remote desktop (RDP/VNC)
  virt <action>         Virtualization (KVM/QEMU/Docker)
  power <action>        Power status and disabled sleep/suspend mutations
  catalog <kind>        Query software/component/bundle state
  runtime <action>      Runtime and package-manager status
  conda channels <act>  Miniforge channel configuration
  timeshift <action>    Timeshift quick setup (enable/disable/status)
  workspace-guard <act> Workspace guard setup & state (enable/disable/status/handbook)
  stack <action>        Software stacks — bridge to linxira-component-manager (list/status/install/tui)
  env <action>          Environment variables in /etc/profile.d/linxira-env.sh (list/get/set/unset)
  tui                   Interactive number menu (pure bash, same commands)
  gpu <action>          GPU driver management
  net <action>          Network diagnostics & fixes
  info                  Show system information
  status                Show a quick system status summary
  help                  Show this help

${BOLD}Workspace Guard:${NC}
  linxira-config workspace-guard status            Show guard configuration, store and timer state
  linxira-config workspace-guard status --json     Same, as one line of JSON
  sudo linxira-config workspace-guard enable      Pick a disk, create the ext4 store, register, start the timer
  sudo linxira-config workspace-guard disable     Stop the timer, keep every stored recovery point
  linxira-config workspace-guard handbook         Print the AI-readable handbook manifest
  linxira-components guard <status|list|snapshot|restore>  Day-to-day guard operations

${BOLD}Machine-readable output (--json):${NC}
  linxira-config workspace-guard status --json
  linxira-config ssh status --json
  linxira-config net diag --json
  linxira-config mirror arch list --json

${BOLD}Security:${NC}
  linxira-config security status       Show security posture
  linxira-config security harden       Disabled pending transactional backend
  linxira-config security ufw on|off   Enable/disable UFW firewall
  linxira-config security ufw status   Show firewall rules
  linxira-config security ufw allow <port>   Allow a TCP port through UFW

${BOLD}SSH:${NC}
  linxira-config ssh on|off            Enable/disable remote SSH access (installs openssh,\n                                       enables sshd, allows password auth)
  linxira-config ssh status            Show SSH status & connection info
  linxira-config ssh port <number>     Change SSH port
  linxira-config ssh key list                    List public keys
  linxira-config ssh key show [name]             Show a public key
  linxira-config ssh key fingerprint [name]      Show a key fingerprint
  linxira-config ssh key generate [name]          Generate an Ed25519 key
  linxira-config ssh key remove <name> --yes      Remove one key pair
  linxira-config ssh authorized list              List authorized keys
  linxira-config ssh authorized add <public-key>  Add one plain public key
  linxira-config ssh authorized remove <fingerprint> --yes

${BOLD}Logs (diagnostics):${NC}
  linxira-config logs collect          收集诊断日志到 ~/linxira-logs/
  linxira-config logs upload [file]    上传日志并返回分享链接(0x0.st/termbin)

${BOLD}Catalog (read-only):${NC}
  linxira-config catalog software [list] [--all|--status <state>]
  linxira-config catalog component [list] [--all|--status <state>]
  linxira-config catalog bundle [list] [--all|--status <state>]
  linxira-config catalog <kind> show <id>

${BOLD}Remote Desktop:${NC}
  linxira-config rdp on|off            Disabled pending transactional backend
                                       (xrdp not yet in signed repositories)
  linxira-config rdp vnc-on|vnc-off    Disabled pending transactional backend
                                       (per-user TigerVNC session policy pending)

${BOLD}Virtualization:${NC}
  linxira-config virt status           Check virtualization support
  linxira-config virt kvm-on|docker-on|podman-on
                                        Disabled pending transactional backend

${BOLD}Power:${NC}
  linxira-config power status          Show power settings
  linxira-config power <action>        Disabled pending corrected power backend

${BOLD}Network:${NC}
  linxira-config net diag              Full network diagnostics
  linxira-config net dns               Show current DNS servers
  linxira-config net dns set <ip>      Set DNS server (write /etc/resolv.conf)

${BOLD}Mirror:${NC}
  linxira-config mirror <type> list          List Arch, npm, pip, AUR, Flatpak, or Go sources
  linxira-config mirror <type> speed [id]    Measure source latency
  linxira-config mirror <type> auto          Probe all sources and select the fastest
  linxira-config mirror <type> set <id|url>  Select a source (user-scoped for npm/pip/aur/go)
  linxira-config mirror <type> reset         Restore the official source
  linxira-config mirror aur set <https-url>  Set a validated custom AUR Git mirror
  linxira-config mirror flatpak set <id|url> Configure an explicit Flatpak remote
  linxira-config mirror go set <id|url>      Configure the Go module proxy

${BOLD}Miniforge:${NC}
  linxira-config conda channels list       Show configured Miniforge channels
  linxira-config conda channels add <id>   Add conda-forge or bioconda
