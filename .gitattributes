# 强制 LF 行尾：Windows 编辑不会破坏 Linux 构建脚本/配置文件
*.sh     text eol=lf
*.py     text eol=lf
*.conf   text eol=lf
*.hook   text eol=lf
*.service text eol=lf
*.desktop text eol=lf
*.install text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf

# 二进制文件不转换
*.iso    binary
*.zst    binary
*.xz     binary
*.gz     binary
*.png    binary
*.jpg    binary
*.webp   binary
*.ttf    binary
*.woff2  binary
*.sfs    binary
*.x86_64 text eol=lf
